# 二周目协会 · 环境变量示例
# 复制为 .env.local 并填入真实值：cp .env.example .env.local

# === LLM ===
# 也可以在应用里「设置 → 模型与渠道 → 自定义 API」填地址/模型/Key（存本机数据库）。
# 下面两个是内置渠道的 Key（可选）。
# DeepSeek 官方（https://api.deepseek.com）
DEEPSEEK_API_KEY=
# OpenCode Go（https://opencode.ai/zen/go/v1，套餐端点）
OPENCODE_API_KEY=
# 可选：覆盖 OpenCode Go 端点 / 默认模型
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# OPENCODE_MODEL=deepseek-v4.1-flash

# === 定时任务（可选）===
# 设为 1 启用逾期巡检（断签判定 + 休整卷轴保全）
CRON_ENABLED=1

# === 生图（可选；一般直接在「设置 → 生图」里改，这里只是预设兜底）===
# IMAGE_ENABLED=0
# IMAGE_BACKEND=mflux            # mflux | api
# IMAGE_MODEL=flux2-klein-4b
# IMAGE_API_BASE_URL=
# IMAGE_API_KEY=
# IMAGE_API_MODEL=
# IMAGE_LORA_PATH=
# IMAGE_LORA_MODEL=z-image-turbo
# IMAGE_LORA_SCALE=0.8
# IMAGE_LORA_TRIGGER=

# === 数据库（可选）===
# 默认 data/ngplus.db
# DATABASE_PATH=data/ngplus.db
